#!/usr/bin/env bash
# btw - branch/tmux/worktree helper
#
# Usage:
#   btw <work_slug>          Create a git worktree + tmux session and drop into a dev layout
#   btw list                 List active btw worktrees (and whether a tmux session exists)
#   btw remove [-f] [<slug>] Tear down the tmux session, worktree folder, and branch
#                            (slug defaults to the worktree you're currently in)
#
# Deployment config (set these in your machine-local ~/.zshrc, not in the tracked
# ~/.zshrc.kalle):
#   BTW_DEFAULT_REPO   Git repo to use when you run btw outside of any git project.
#   BTW_WORKTREE_BASE  Canonical checkout/path prefix for new sibling worktrees.
#   BTW_HARNESS        AI harness command for the bottom pane.  Default: claude
#   BTW_EDITOR         Editor command for the top pane.          Default: nvim .
#   BTW_BASE_BRANCH    Branch on origin to base new worktrees on.
#                      Default: origin's default branch (origin/HEAD, or main/master)
set -euo pipefail

BTW_HARNESS="${BTW_HARNESS:-claude}"
BTW_EDITOR="${BTW_EDITOR:-nvim .}"

die() {
  printf 'btw: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  btw <work_slug>          Create a git worktree + tmux session with a dev layout
  btw list                 List active btw worktrees
  btw remove [-f] [<slug>] Remove the tmux session, worktree folder, and branch
                           (defaults to the worktree you're currently in)
EOF
  exit 2
}

# Resolve two paths independently:
#   REPO_COMMON   the shared Git directory, which identifies the repository
#   WORKTREE_BASE the stable checkout/path prefix used for Git commands and for
#                 naming new sibling worktrees
#
# This supports conventional checkouts, standalone bare repositories, and
# Android repo-style checkouts whose .git is under .repo/projects.
resolve_repo() {
  local start="$PWD"
  if git -C "$start" rev-parse --absolute-git-dir >/dev/null 2>&1; then
    :
  elif [ -n "${BTW_DEFAULT_REPO:-}" ]; then
    [ -d "$BTW_DEFAULT_REPO" ] || die "BTW_DEFAULT_REPO is set but not a directory: $BTW_DEFAULT_REPO"
    git -C "$BTW_DEFAULT_REPO" rev-parse --absolute-git-dir >/dev/null 2>&1 \
      || die "BTW_DEFAULT_REPO is not a git repo: $BTW_DEFAULT_REPO"
    start="$BTW_DEFAULT_REPO"
  else
    die "not inside a git project and BTW_DEFAULT_REPO is not set"
  fi

  REPO_COMMON="$(git -C "$start" rev-parse --path-format=absolute --git-common-dir)" \
    || die "could not resolve the repository's shared Git directory"

  local base="${BTW_WORKTREE_BASE:-}"
  if [ -z "$base" ]; then
    base="$(git -C "$start" config --path --get btw.worktreeBase 2>/dev/null || true)"
  fi

  if [ -z "$base" ]; then
    case "$REPO_COMMON" in
      */.repo/projects/*.git)
        # Android repo layout:
        #   <root>/.repo/projects/path/to/project.git -> <root>/path/to/project
        local repo_root project_path
        repo_root="${REPO_COMMON%%/.repo/projects/*}"
        project_path="${REPO_COMMON#"$repo_root/.repo/projects/"}"
        project_path="${project_path%.git}"
        base="$repo_root/$project_path"
        ;;
      */.git)
        # Conventional checkout: /path/project/.git -> /path/project
        base="${REPO_COMMON%/.git}"
        ;;
      *)
        # Standalone bare repository.  Strip an optional .git suffix so a bare
        # /path/project.git creates siblings such as /path/project.<slug>.
        base="${REPO_COMMON%.git}"
        ;;
    esac
  fi

  case "$base" in
    /*) : ;;
    *) base="$PWD/$base" ;;
  esac
  # Normalize with cd/pwd -P rather than realpath: BSD realpath has no -m, and
  # the base has to exist anyway.
  WORKTREE_BASE="$(cd -- "$base" 2>/dev/null && pwd -P)" \
    || die "resolved worktree base is not a directory: $base (set BTW_WORKTREE_BASE to override)"

  local base_common
  base_common="$(git -C "$WORKTREE_BASE" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "resolved worktree base is not a git repo: $WORKTREE_BASE (set BTW_WORKTREE_BASE to override)"
  [ "$base_common" = "$REPO_COMMON" ] \
    || die "worktree base belongs to a different git repo: $WORKTREE_BASE (set BTW_WORKTREE_BASE to override)"
}

# Path a worktree for <slug> would live at: sibling of the main project folder.
worktree_path_for() {
  local main="$1" slug="$2"
  printf '%s/%s.%s' "$(dirname "$main")" "$(basename "$main")" "$slug"
}

# Print the registered worktree path whose checked-out branch matches <slug>.
# Return 1 when the branch is not checked out and 2 when Git cannot list the
# repository's worktrees.
registered_worktree_for_branch() {
  local main="$1" slug="$2" porcelain line wt="" branch
  porcelain="$(git -C "$main" worktree list --porcelain)" || return 2

  while IFS= read -r line; do
    case "$line" in
      worktree\ *) wt="${line#worktree }" ;;
      branch\ *)
        branch="${line#branch }"
        branch="${branch#refs/heads/}"
        if [ "$branch" = "$slug" ]; then
          printf '%s\n' "$wt"
          return 0
        fi
        ;;
    esac
  done <<< "$porcelain"

  return 1
}

# tmux session name for a slug.  tmux silently rewrites '.' and ':' in session
# names to '_' (and '.' is its window.pane separator), so a dotted slug like
# release-notes-1.3 would otherwise create a session our targets never match —
# and send-keys would land in the caller's current pane.
session_name_for() {
  printf '%s' "${1//[.:]/_}"
}

session_exists() {
  tmux has-session -t "=$(session_name_for "$1")" 2>/dev/null
}

# The origin ref new branches start from: $BTW_BASE_BRANCH if set, otherwise
# origin's default branch (via the origin/HEAD symref, falling back to
# main/master).  Prints nothing if origin has no usable branch.
base_ref() {
  local main="$1" ref b
  if [ -n "${BTW_BASE_BRANCH:-}" ]; then
    printf 'origin/%s' "$BTW_BASE_BRANCH"
    return
  fi
  if ref="$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD)"; then
    printf '%s' "$ref"
    return
  fi
  for b in main master; do
    if git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$b"; then
      printf 'origin/%s' "$b"
      return
    fi
  done
}

cmd_create() {
  local slug="$1"
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed"

  local main wt
  resolve_repo
  main="$WORKTREE_BASE"
  wt="$(worktree_path_for "$main" "$slug")"

  # Create the worktree + branch if it isn't there yet.
  if [ -d "$wt" ]; then
    printf 'btw: reusing existing worktree %s\n' "$wt" >&2
  elif git -C "$main" show-ref --verify --quiet "refs/heads/$slug"; then
    git -C "$main" worktree add "$wt" "$slug"
  else
    # New branch: base it on a fresh origin default branch when there is an
    # origin; repos without one fall back to the main checkout's HEAD.
    local base=""
    if git -C "$main" remote get-url origin >/dev/null 2>&1; then
      printf 'btw: fetching origin\n' >&2
      git -C "$main" fetch origin
      base="$(base_ref "$main")"
      [ -n "$base" ] || die "cannot determine base branch on origin; set BTW_BASE_BRANCH"
      git -C "$main" show-ref --verify --quiet "refs/remotes/$base" \
        || die "no such branch on origin: $base"
    fi
    if [ -n "$base" ]; then
      git -C "$main" worktree add --no-track "$wt" -b "$slug" "$base"
    else
      git -C "$main" worktree add "$wt" -b "$slug"
    fi
  fi

  # Create the tmux session with the dev layout if it isn't there yet.
  local sess
  sess="$(session_name_for "$slug")"
  if ! session_exists "$slug"; then
    tmux new-session -d -s "$sess" -c "$wt" -n dev
    local top bottom
    top="$(tmux display-message -p -t "=$sess:dev" '#{pane_id}')"
    tmux send-keys -t "$top" "$BTW_EDITOR" C-m
    bottom="$(tmux split-window -v -P -F '#{pane_id}' -t "$top" -c "$wt")"
    tmux send-keys -t "$bottom" "$BTW_HARNESS" C-m
    tmux select-pane -t "$top"
  fi

  # Drop the user into the session.
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$sess"
  else
    tmux attach-session -t "=$sess"
  fi
}

cmd_list() {
  resolve_repo
  local main="$WORKTREE_BASE" porcelain
  porcelain="$(git -C "$main" worktree list --porcelain)" \
    || die "could not list worktrees for $main"

  local found=0 line wt branch slug marker
  # Parse porcelain output; skip the main worktree, report the rest.
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) wt="${line#worktree }" ;;
      branch\ *)
        branch="${line#branch }"
        branch="${branch#refs/heads/}"
        [ "$wt" = "$main" ] && continue
        [ "$wt" = "$REPO_COMMON" ] && continue
        slug="$branch"
        if session_exists "$slug"; then marker="tmux"; else marker="----"; fi
        printf '%-4s  %-24s  %s\n' "$marker" "$slug" "$wt"
        found=1
        ;;
    esac
  done <<< "$porcelain"

  [ "$found" -eq 1 ] || printf 'btw: no worktrees\n' >&2
}

cmd_remove() {
  local force=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) break ;;
    esac
  done
  [ "$#" -le 1 ] || usage

  local main wt slug
  resolve_repo
  main="$WORKTREE_BASE"

  if [ "$#" -eq 1 ]; then
    slug="$1"
    local lookup_rc
    if wt="$(registered_worktree_for_branch "$main" "$slug")"; then
      [ "$wt" != "$main" ] \
        || die "refusing to remove the canonical worktree: $main"
      [ "$wt" != "$REPO_COMMON" ] \
        || die "refusing to remove the repository's shared Git directory: $REPO_COMMON"
    else
      lookup_rc="$?"
      [ "$lookup_rc" -eq 1 ] \
        || die "could not list worktrees while resolving branch: $slug"
      # Preserve support for an unregistered/stale btw directory.
      wt="$(worktree_path_for "$main" "$slug")"
    fi
  else
    # No slug given: infer it from the worktree we're standing in.
    local cur
    cur="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" \
      || die "no slug given and not inside a git worktree"
    [ "$cur" != "$main" ] \
      || die "no slug given and this is the main checkout, not a btw worktree"
    slug="$(git -C "$cur" rev-parse --abbrev-ref HEAD)"
    wt="$cur"
  fi

  # Remove the worktree.  (git runs with -C "$main", so removing the directory we
  # happen to be standing in is fine.)
  if [ -d "$wt" ]; then
    if [ "$force" -eq 1 ]; then
      git -C "$main" worktree remove --force "$wt"
    else
      git -C "$main" worktree remove "$wt" \
        || die "worktree has changes; re-run with -f to force: btw remove -f $slug"
    fi
    printf 'btw: removed worktree %s\n' "$wt" >&2
  else
    git -C "$main" worktree prune
  fi

  # Delete the branch.
  if git -C "$main" show-ref --verify --quiet "refs/heads/$slug"; then
    if [ "$force" -eq 1 ]; then
      git -C "$main" branch -D "$slug"
    else
      git -C "$main" branch -d "$slug" \
        || die "branch $slug is not fully merged; re-run with -f to force: btw remove -f $slug"
    fi
    printf 'btw: deleted branch %s\n' "$slug" >&2
  fi

  # Kill the tmux session last: if we were invoked from inside this very session,
  # doing it earlier would SIGHUP this script mid-teardown.
  if session_exists "$slug"; then
    printf 'btw: killing tmux session %s\n' "$slug" >&2
    tmux kill-session -t "=$(session_name_for "$slug")"
  fi
}

main() {
  [ "$#" -ge 1 ] || usage
  case "$1" in
    list) shift; [ "$#" -eq 0 ] || usage; cmd_list ;;
    remove) shift; cmd_remove "$@" ;;
    -h|--help) usage ;;
    -*) die "unknown option: $1" ;;
    *) [ "$#" -eq 1 ] || usage; cmd_create "$1" ;;
  esac
}

main "$@"
